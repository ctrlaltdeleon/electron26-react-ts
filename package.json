{
  "name": "electron26-react-ts",
  "version": "0.1.1",
  "private": true,
  "description": "Electron 26 + React + TypeScript + electron-builder boilerplate",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron:build": "tsc -p tsconfig.electron.json -w --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron:build\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^24.0.0",
    "@types/react-calendar": "3.5.2",
    "@types/react": "18.0.12",
    "@types/react-dom": "18.0.5",
    "@types/supertest": "^2.0.12",
    "@types/testing-library__jest-dom": "^5.14.2",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "26.0.0",
    "electron-builder": "^25.0.0",
    "electronmon": "^2.0.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "expect": "27.5.1",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.0.3",
    "react-test-renderer": "16.14.0",
    "sonarqube-scanner": "2.5.0",
    "supertest": "^6.3.3",
    "testcafe": "3.3.0",
    "testcafe-browser-provider-electron": "^0.0.19",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-static-block": "7.18.0",
    "@devexpress/dx-core": "3.0.6",
    "@devexpress/dx-grid-core": "3.0.6",
    "@devexpress/dx-react-core": "3.0.6",
    "@devexpress/dx-react-grid": "3.0.6",
    "@devexpress/dx-react-grid-material-ui": "3.0.6",
    "@emotion/react": "11.10.5",
    "@emotion/styled": "11.9.3",
    "@mui/codemod": "5.10.14",
    "@mui/icons-material": "5.10.14",
    "@mui/lab": "5.0.0-alpha.108",
    "@mui/material": "5.10.14",
    "@mui/styles": "5.8.6",
    "@mui/types": "7.2.1",
    "@mui/x-date-pickers": "5.0.9",
    "@reduxjs/toolkit": "1.9.3",
    "@types/react-beautiful-dnd": "13.1.2",
    "@types/react-redux": "7.1.21",
    "@types/socket.io-client": "1.4.32",
    "@types/uuid": "7.0.0",
    "browser-image-compression": "1.0.14",
    "dayjs": "^1.11.9",
    "file-saver": "2.0.2",
    "jimp": "0.16.1",
    "jsdom": "16.7.0",
    "loglevel": "1.8.0",
    "material-table": "1.69.1",
    "moment": "2.29.4",
    "path": "0.12.7",
    "react": "18.1.0",
    "react-beautiful-dnd": "13.1.0",
    "react-calendar": "3.9.0",
    "react-dom": "18.1.0",
    "react-draggable": "4.4.5",
    "react-highlight-words": "0.20.0",
    "react-number-format": "5.2.2",
    "react-virtuoso": "2.16.1",
    "redux-logger": "^3.0.6",
    "socket.io": "2.3.0",
    "tss-react": "4.4.4",
    "typeface-roboto": "1.1.13",
    "uuid": "8.3.1"
  },
  "build": {
    "appId": "com.example.electron26reactts",
    "productName": "Electron26ReactTS",
    "files": [
      "dist/**/*",
      "dist/renderer/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
